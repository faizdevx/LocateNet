# Copy to .env and edit. Never commit .env.

# --- Required outside debug mode ---
# Long random string used to sign sessions. Generate: python -c "import secrets; print(secrets.token_hex(32))"
LOCATENET_SECRET_KEY=

# --- First-run setup (init_system.py) ---
# Password for the initial admin account. If empty, a random one is generated and printed once.
LOCATENET_ADMIN_PASSWORD=

# --- Runtime ---
# 1 enables Flask debug mode and allows a random secret key. Keep 0 in production.
FLASK_DEBUG=0
# Path of the SQLite database (default: database.db in the project folder).
LOCATENET_DB=

# --- Matching (measured on LFW, see docs/OPERATING_POINT.md; leave unset to use the defaults) ---
# Cosine similarity at or above which a face becomes a match that needs human review (default 0.312, FPIR 1%).
MATCH_THRESHOLD=0.312
# Cosine similarity at or above which a match is labelled "High Similarity" (default 0.634, FPIR 0.1%).
HIGH_CONF_THRESHOLD=0.634
# Minimum face-detector score for a face to be embedded (see eval/results/quality.json).
DET_SCORE_MIN=0.6
# Detector input size in pixels (square). 640 recommended; 1024 misses large close-up faces.
DET_SIZE=640
# Number of nearest neighbours inspected per face.
TOP_K=5

# --- Experimental ---
# 1 enables the placeholder body ReID (needs requirements-reid.txt). It is not a valid ReID model.
ENABLE_REID=0

# --- Calibration (estimated match likelihood shown to officers) ---
# Assumed share of searched faces that belong to an enrolled person. The likelihood is re-targeted to this prior.
CALIBRATION_PRIOR=0.1
# Path of the calibrator JSON (default: models/calibrator.json). If missing, only raw similarity is shown.
LOCATENET_CALIBRATOR=

# --- Week 3: multi-photo cases, age, video, feedback loop (defaults follow eval/results/*.json) ---
# Retry detection on a 2x padded canvas when no face is found (close-up portraits).
DETECT_PAD_RETRY=1
# How several reference photos of one case are combined: max | mean_template | quality_weighted_mean | top2_mean
TEMPLATE_STRATEGY=max
MAX_PHOTOS_PER_CASE=5
# Smallest face width (px) accepted for a reference photo.
MIN_ENROL_FACE_PX=32
# Up-weight recent reference photos (negative result on FG-NET; keep 0).
ENABLE_RECENCY_WEIGHTING=0
RECENCY_TAU=5
# Warn when the newest reference photo is older than this many years.
AGE_GAP_WARNING_YEARS=5
# Video: best_frame | mean | quality_weighted_mean | top_n_quality_mean
TRACK_AGG_STRATEGY=best_frame
ENABLE_TRACK_SPLIT=1
TRACK_SPLIT_THRESHOLD=0.1
VIDEO_FRAME_STRIDE=5
# Feedback loop
ENABLE_NEG_SUPPRESSION=1
NEG_SUPPRESS_THRESHOLD=0.6
MAX_SIGHTING_TEMPLATES=3
AUDIT_SAMPLE_RATE=0.02
RETENTION_DAYS=90
FIELD_MIN_N=30

# --- ZIPNET public-record sync (see docs/ZIPNET_SYNC.md) ---
# 1 = `python app.py` starts a background worker that makes OUTBOUND HTTPS requests to ZIPNET_BASE_URL:
# a resumable historical backfill, then recurring incremental updates. 0 = no requests are ever made.
ZIPNET_SYNC_ENABLED=1
# `python app.py` launches the worker as a child process. Use 0 when it runs as its own service (Docker Compose sets this).
ZIPNET_AUTOSTART_WORKER=1
ZIPNET_BASE_URL=https://zipnet.delhipolice.gov.in
# Comma-separated sections to import (default: all six).
ZIPNET_SECTIONS=missing_persons,unidentified_persons,unidentified_dead_bodies,stolen_vehicles,unclaimed_seized_vehicles,missing_mobiles
# Separate SQLite file for imported records (default: zipnet_external.db next to the main database).
ZIPNET_DB=
ZIPNET_USER_AGENT=LocateNet-ZIPNET-Sync/1.0 (public-record research; respects rate limits)
# Rows per request (10-100).
ZIPNET_PAGE_SIZE=50
# Minimum seconds between requests (>= 0.5), request timeout, retries per request, and exponential backoff bounds.
ZIPNET_REQUEST_DELAY_SECONDS=2
ZIPNET_REQUEST_TIMEOUT_SECONDS=30
ZIPNET_MAX_RETRIES=4
ZIPNET_BACKOFF_BASE_SECONDS=2
ZIPNET_BACKOFF_MAX_SECONDS=60
# Backfill pages per section per turn (sections take turns, so no section starves the others).
ZIPNET_PAGES_PER_TURN=20
# Optional cap on total backfill pages per section (0 = unlimited). A capped section is reported "NOT complete".
ZIPNET_BACKFILL_MAX_PAGES=0
# Incremental sync: how often, how many pages per turn, and how many days of already-seen records to re-check.
ZIPNET_INCREMENTAL_INTERVAL_MINUTES=60
ZIPNET_INCREMENTAL_MAX_PAGES=100
ZIPNET_INCREMENTAL_OVERLAP_DAYS=1
# Single-worker lease: another worker may take over only after this many seconds without a heartbeat.
ZIPNET_LOCK_TTL_SECONDS=120
# Wait before retrying a section that failed (doubles per consecutive failure) or was refused by the source.
ZIPNET_FAILURE_COOLDOWN_SECONDS=60
ZIPNET_BLOCKED_COOLDOWN_SECONDS=21600
# Seconds `python app.py` waits for the worker to finish its current page on exit.
ZIPNET_SHUTDOWN_GRACE_SECONDS=20
# Missing-person panel of imported ZIPNET records (/zipnet-records). 1 = public like the registry, 0 = logged-in users only.
ZIPNET_PANEL_PUBLIC=1
