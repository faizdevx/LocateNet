# Copy to .env and edit. Never commit .env.

# --- Required outside debug mode ---
# Long random string used to sign sessions. Generate: python -c "import secrets; print(secrets.token_hex(32))"
LOCATENET_SECRET_KEY=

# --- First-run setup (init_system.py) ---
# Password for the initial admin account. If empty, a random one is generated and printed once.
LOCATENET_ADMIN_PASSWORD=

# --- Runtime ---
# 1 enables Flask debug mode and allows a random secret key. Keep 0 in production.
FLASK_DEBUG=0
# Path of the SQLite database (default: database.db in the project folder).
LOCATENET_DB=

# --- Matching (measured on LFW, see docs/OPERATING_POINT.md; leave unset to use the defaults) ---
# Cosine similarity at or above which a face becomes a match that needs human review (default 0.312, FPIR 1%).
MATCH_THRESHOLD=0.312
# Cosine similarity at or above which a match is labelled "High Similarity" (default 0.634, FPIR 0.1%).
HIGH_CONF_THRESHOLD=0.634
# Minimum face-detector score for a face to be embedded (see eval/results/quality.json).
DET_SCORE_MIN=0.6
# Detector input size in pixels (square). 640 recommended; 1024 misses large close-up faces.
DET_SIZE=640
# Number of nearest neighbours inspected per face.
TOP_K=5

# --- Experimental ---
# 1 enables the placeholder body ReID (needs requirements-reid.txt). It is not a valid ReID model.
ENABLE_REID=0

# --- Calibration (estimated match likelihood shown to officers) ---
# Assumed share of searched faces that belong to an enrolled person. The likelihood is re-targeted to this prior.
CALIBRATION_PRIOR=0.1
# Path of the calibrator JSON (default: models/calibrator.json). If missing, only raw similarity is shown.
LOCATENET_CALIBRATOR=

# --- Week 3: multi-photo cases, age, video, feedback loop (defaults follow eval/results/*.json) ---
# Retry detection on a 2x padded canvas when no face is found (close-up portraits).
DETECT_PAD_RETRY=1
# How several reference photos of one case are combined: max | mean_template | quality_weighted_mean | top2_mean
TEMPLATE_STRATEGY=max
MAX_PHOTOS_PER_CASE=5
# Smallest face width (px) accepted for a reference photo.
MIN_ENROL_FACE_PX=32
# Up-weight recent reference photos (negative result on FG-NET; keep 0).
ENABLE_RECENCY_WEIGHTING=0
RECENCY_TAU=5
# Warn when the newest reference photo is older than this many years.
AGE_GAP_WARNING_YEARS=5
# Video: best_frame | mean | quality_weighted_mean | top_n_quality_mean
TRACK_AGG_STRATEGY=best_frame
ENABLE_TRACK_SPLIT=1
TRACK_SPLIT_THRESHOLD=0.1
VIDEO_FRAME_STRIDE=5
# Feedback loop
ENABLE_NEG_SUPPRESSION=1
NEG_SUPPRESS_THRESHOLD=0.6
MAX_SIGHTING_TEMPLATES=3
AUDIT_SAMPLE_RATE=0.02
RETENTION_DAYS=90
FIELD_MIN_N=30
