# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases and runtime output
*.db
*.sqlite3
logs/
uploads/

# Vector database artifacts
vector_db/storage/

# OS/editor noise
.DS_Store
Thumbs.db

# Runtime data, PII and model weights (never commit these)
resources/
uploads/
*.pt
*.onnx
.env

# Evaluation datasets and cached embeddings (never commit)
data/
eval/cache/

# SQLite write-ahead log / shared-memory files (ZIPNET sync database runs in WAL mode)
*.db-wal
*.db-shm
*.db-journal
